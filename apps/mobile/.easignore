# ── Paths are relative to the EAS archive root (repo root) ──────────────────
# For monorepos, EAS archives from the git root, so all paths here are
# relative to /Users/nonso/Desktop/valen (the repo root).

# ── Node modules (installed fresh on build server) ───────────────────────────
**/node_modules

# ── Expo cache ───────────────────────────────────────────────────────────────
**/.expo
**/dist
**/web-build

# ── iOS native (Pods reinstalled on build server) ────────────────────────────
**/ios/Pods
**/ios/build
**/ios/DerivedData

# ── Android native artifacts (EAS uses gradle on the build server) ───────────
apps/mobile/android/.gradle
apps/mobile/android/.kotlin
apps/mobile/android/app/build
apps/mobile/android/build

# ── Backend ──────────────────────────────────────────────────────────────────
apps/backend

# ── Monorepo root clutter ────────────────────────────────────────────────────
.git
.git.corrupt
.claude
misc

# ── macOS Finder duplicate directories (DO NOT REMOVE — these are ~500MB) ────
apps 2
node_modules 2
packages 2
web 2
untitled folder
android
web

# ── Root seed/util scripts (not needed for build) ────────────────────────────
seed.js
seed-*.js
seed-extras.js
check-today.js

# ── Markdown docs at root ────────────────────────────────────────────────────
*.md
.mcp.json

# ── Native artifacts ─────────────────────────────────────────────────────────
**/*.orig.*
**/*.jks
**/*.p8
**/*.p12
**/*.key
**/*.mobileprovision
**/*.keystore
**/*.pem

# ── Local dev files ──────────────────────────────────────────────────────────
**/.env
**/.env.*
**/.env.local

# ── Google OAuth client secrets ──────────────────────────────────────────────
**/client_secret_*.json

# ── Stale duplicate app.json files ───────────────────────────────────────────
apps/mobile/app 2.json
apps/mobile/app 3.json
apps/mobile/app 4.json

# ── Build & debug ────────────────────────────────────────────────────────────
npm-debug.*
.DS_Store
*.tsbuildinfo
.metro-health-check*
