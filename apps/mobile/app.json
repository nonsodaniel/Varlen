{
  "expo": {
    "name": "Sivena",
    "slug": "sivena",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "sivena",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#0F1020",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sivena.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Sivena uses your camera to let you add photos to shared memories and tasks.",
        "NSPhotoLibraryUsageDescription": "Sivena uses your photo library to let you add photos to shared memories and tasks.",
        "NSPhotoLibraryAddUsageDescription": "Sivena saves photos to your library.",
        "NSMicrophoneUsageDescription": "Sivena uses your microphone for voice messages.",
        "NSUserTrackingUsageDescription": "This identifier is used to provide a personalized experience and measure app performance."
      }
    },
    "android": {
      "package": "com.sivena.app",
      "adaptiveIcon": {
        "backgroundColor": "#16213E",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "sivena" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "sivena.app", "pathPrefix": "/join" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./app"
        }
      ],
      "expo-asset",
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#6C63FF"
        }
      ],
      "expo-image-picker",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.130358336300-f4bnuad9j1sfkme0o7rttsojv6qjjg1n"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "useLegacyPackaging": false
          }
        }
      ],
      "expo-secure-store",
      [
        "@sentry/react-native/expo",
        {
          "organization": "sivena",
          "project": "sivena-mobile"
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false,
        "root": "./app"
      },
      "eas": {
        "projectId": "cdbcc2a8-ede1-41d0-8e14-e27dbe1fa285"
      }
    },
    "owner": "sivena-mobile",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/cdbcc2a8-ede1-41d0-8e14-e27dbe1fa285"
    }
  }
}
