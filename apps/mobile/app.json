{
  "expo": {
    "name": "Valen",
    "slug": "valen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "valen",
    "splash": {
      "backgroundColor": "#0F1020",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.valen.app"
    },
    "android": {
      "package": "com.valen.app",
      "adaptiveIcon": {
        "backgroundColor": "#16213E",
        "foregroundImage": "./assets/adaptive-icon.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-crypto",
      "@react-native-google-signin/google-signin"
    ]
  }
}
