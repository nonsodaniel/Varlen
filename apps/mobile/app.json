{
  "expo": {
    "name": "Valen",
    "slug": "valen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "valen",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.valen.app"
    },
    "android": {
      "package": "com.valen.app",
      "adaptiveIcon": {
        "backgroundColor": "#245A4D",
        "foregroundImage": "./assets/adaptive-icon.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-crypto"
    ],
    "extra": {
      "googleExpoClientId": "YOUR_EXPO_CLIENT_ID.apps.googleusercontent.com",
      "googleIosClientId": "YOUR_IOS_CLIENT_ID.apps.googleusercontent.com",
      "googleAndroidClientId": "YOUR_ANDROID_CLIENT_ID.apps.googleusercontent.com",
      "googleWebClientId": "YOUR_WEB_CLIENT_ID.apps.googleusercontent.com"
    }
  }
}
