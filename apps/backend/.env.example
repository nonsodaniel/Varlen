# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:8081

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Redis
REDIS_URL=redis://localhost:6379

# Authentication
JWT_ACCESS_SECRET=change-this-to-a-secure-random-string-min-32-chars
JWT_REFRESH_SECRET=change-this-to-another-secure-random-string-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Encryption
ENCRYPTION_KEY=generate-a-32-char-hex-string-here

# Email (Resend — https://resend.com)
# Add sivena.app as a verified domain in Resend, then create an API key
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=Sivena <noreply@sivena.app>
APP_URL=https://sivena.app
SUPPORT_EMAIL=support@sivena.app

# AI Assistant (OpenAI)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Sentry error monitoring (https://sentry.io)
SENTRY_DSN=https://your-key@oXXXXXX.ingest.sentry.io/XXXXXXX
